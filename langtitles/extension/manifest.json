{
  "manifest_version": 2,
  "name": "Langtitles",
  "version": "0.1.0",
  "description": "Langtitles: learn languages from what you watch. Word-by-word subtitle breakdowns with furigana and pinyin, grammar guides, a word bank, and subtitles fetched for the episode, on any streaming site. Powered by Claude with your own API key.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "langtitles@langtitles.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "scripts": [
      "vendor/anthropic-sdk.js",
      "shared/settings.js",
      "shared/subtitles.js",
      "shared/lang.js",
      "background/prompt.js",
      "background/cache.js",
      "background/claude.js",
      "background/sniffer.js",
      "shared/episode.js",
      "background/files.js",
      "background/providers.js",
      "shared/strokes.js",
      "shared/srs.js",
      "shared/pitch.js",
      "background/main.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "css": [
        "content/content.css"
      ],
      "js": [
        "shared/settings.js",
        "shared/subtitles.js",
        "shared/lang.js",
        "shared/guide.js",
        "shared/episode.js",
        "shared/sync.js",
        "shared/ruby.js",
        "shared/srs.js",
        "shared/strokes.js",
        "shared/speech.js",
        "shared/pitch.js",
        "content/content.js"
      ]
    }
  ],
  "browser_action": {
    "default_title": "Langtitles",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    "icons/icon.svg"
  ]
}
