; Glance configuration. Copy this file to /config/glance/config.ini and edit it.
; Changes apply on the next request: no reboot or rebuild needed.
;
; Inline comments must start with " ;" (a space before the semicolon).

[api]
; Your Anthropic API key. It is stored in PLAIN TEXT on the SD card.
; Set a monthly spend limit in the Anthropic Console (Settings > Limits).
key=sk-ant-...
; Any current vision-capable Claude model ID.
;   claude-opus-5-5   most capable (default suggestion)
;   claude-sonnet-5-5 faster, cheaper
;   claude-haiku-5-5  fastest, cheapest
model=claude-opus-5-5
max_tokens=400

[learning]
target_language=Spanish        ; language you are learning
explain_in=English

[presets]
1=Translate the text on screen and explain one useful grammar or phrasing point.
2=I'm stuck. Based on this screen, what should I do next? Avoid big spoilers.
3=Explain what's on this screen.

[debug]
; URL used by the M2 "Test HTTPS" button. With a valid key this returns 200.
test_url=https://api.anthropic.com/v1/models
; Optional PEM file with extra root CAs. Leave empty to use the console's
; built-in trust store (normal case).
ca_file=
