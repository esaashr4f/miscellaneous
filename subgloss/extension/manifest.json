{
  "manifest_version": 2,
  "name": "SubGloss",
  "version": "0.1.0",
  "description": "Word-by-word subtitle breakdowns on any streaming site: what each word is built from, the sentence structure, and deeper explanations on hover. Powered by Claude with your own API key.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "subgloss@subgloss.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "scripts": [
      "vendor/anthropic-sdk.js",
      "shared/settings.js",
      "shared/subtitles.js",
      "shared/lang.js",
      "background/prompt.js",
      "background/cache.js",
      "background/claude.js",
      "background/sniffer.js",
      "background/main.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "css": [
        "content/content.css"
      ],
      "js": [
        "shared/settings.js",
        "shared/subtitles.js",
        "shared/lang.js",
        "shared/guide.js",
        "content/content.js"
      ]
    }
  ],
  "browser_action": {
    "default_title": "SubGloss",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
